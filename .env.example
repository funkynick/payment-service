# Скопируйте в .env при необходимости. docker-compose.yml уже содержит рабочие значения.
API_KEY=dev-secret-key
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
WEBHOOK_SECRET=dev-webhook-secret

# Эмуляция платёжного шлюза
GATEWAY_DELAY_MIN=2.0
GATEWAY_DELAY_MAX=5.0
GATEWAY_SUCCESS_RATE=0.9

# Сколько сообщений consumer обрабатывает параллельно
CONSUMER_PREFETCH=10

# Retry: число попыток и базовая задержка (сек). Задержки: base, base*2, base*4 ...
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2.0
WEBHOOK_TIMEOUT=5.0

# Outbox relay
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=100
LOG_LEVEL=INFO
